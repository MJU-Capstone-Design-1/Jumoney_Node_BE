# ────────────────────────────────────────────────────────────
# Jumoney 서버 환경변수 템플릿
# 사용법: 이 파일을 .env로 복사 후 실제 값으로 채워넣으세요.
#   cp .env.example .env
# ────────────────────────────────────────────────────────────

# ── 런타임 ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── 한국투자증권(KIS) 모의투자 ──────────────────────────────
# 5계좌 분배: KOSPI 200 종목을 5개 계좌로 round-robin 분배해 동시에 구독합니다.
# 모든 KEY{N} 와 SECRET{N} 페어를 같이 채워야 그 슬롯이 활성화됩니다.
# 일부만 채워도 동작하지만, 200종목 전체 커버를 위해서는 5계좌 모두 권장.
KIS_APP_KEY1=your_kis_app_key_1
KIS_APP_SECRET1=your_kis_app_secret_1
KIS_APP_KEY2=your_kis_app_key_2
KIS_APP_SECRET2=your_kis_app_secret_2
KIS_APP_KEY3=your_kis_app_key_3
KIS_APP_SECRET3=your_kis_app_secret_3
KIS_APP_KEY4=your_kis_app_key_4
KIS_APP_SECRET4=your_kis_app_secret_4
KIS_APP_KEY5=your_kis_app_key_5
KIS_APP_SECRET5=your_kis_app_secret_5
KIS_URL=https://openapivts.koreainvestment.com:29443
KIS_WS_URL=ws://ops.koreainvestment.com:31000

# ── Redis ──────────────────────────────────────────────────
# REDIS_HOST 값은 실행 방식에 따라 다릅니다:
#   - docker compose로 앱+redis 둘 다 띄울 때:  REDIS_HOST=redis
#   - pnpm dev로 호스트(맥북)에서 앱 실행할 때: REDIS_HOST=127.0.0.1
#     (docker-compose.override.yml로 6379가 호스트에 노출되어 있어야 함)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_password

# ── News Pipeline (Naver + Gemini) ─────────────────────────
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-pro
NEWS_KEYWORDS=경제,금융,주식
NEWS_PER_RUN=30
NEWS_DISPLAY_PER_KEYWORD=10
# 운영 환경에서 /admin/news/run 호출 시 헤더 x-admin-token 검증용
ADMIN_TOKEN=change_me_admin_token
